+def _sage_prefill(impl, prefill_query, kv_cache_tuple, attn_metadata, out_prefill, layer):
+    """Full-attention prefill on the Sage2 FP8 kernel: K/V of every computed token are gathered from the fp8 pages
+    (unit scale) into bf16 rows, the chunk's queries attend with the causal prefix offset, sinks folded via LSE."""
+    from flashrt_structures.adapters.sage2 import attention_fp8
+    k_cache, v_cache = kv_cache_tuple          # (blocks, H, page, D) fp8
+    bt = attn_metadata.frt_pf_block_tables
+    kv_lens = attn_metadata.frt_pf_kv_lens
+    qo = attn_metadata.frt_pf_qo_indptr
+    H, D = impl.num_kv_heads, impl.head_size
+    hnd = k_cache.shape[1] == H and k_cache.shape[2] != H      # (blocks, H, page, D) vs (blocks, page, H, D)
+    page = k_cache.shape[2] if hnd else k_cache.shape[1]
+    if not getattr(impl, "_sage_logged", False):
+        impl._sage_logged = True
+        logger.info("Sage2 prefill: K cache view %s (%s), page %d", tuple(k_cache.shape), "HND" if hnd else "NHD", page)
+    ks, vs = float(layer._k_scale_float), float(layer._v_scale_float)
+    for r, L in enumerate(kv_lens):
+        qs, qe = qo[r], qo[r + 1]
+        if qe <= qs:
+            continue
+        from flashrt_structures.adapters.sage2 import gather_pages_bf16
+        btr = bt[r].contiguous()
+        k = gather_pages_bf16(k_cache, btr, L, hnd, ks, H, D); v = gather_pages_bf16(v_cache, btr, L, hnd, vs, H, D)
+        q = prefill_query[qs:qe].reshape(qe - qs, impl.num_heads, D)
+        out_prefill[qs:qe].copy_(attention_fp8(q, k, v, impl.sinks, impl.scale).reshape(qe - qs, -1).view_as(out_prefill[qs:qe]))
 
 
